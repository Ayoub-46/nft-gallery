# ============================================================
# NFT Viewer Monorepo — .gitignore
# ============================================================

# ── OS & Editor ─────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini

.idea/
.vscode/
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln

# ── Node / npm ───────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.npm

# ── Next.js ──────────────────────────────────────────────────
packages/frontend/.next/
packages/frontend/out/
packages/frontend/build/

# Next.js static export
packages/frontend/dist/

# ── Environment variables ────────────────────────────────────
# Never commit secrets or API keys
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Committed as a template — actual values stay local
# packages/frontend/.env.local

# ── Foundry / Forge ──────────────────────────────────────────
packages/contracts/out/
packages/contracts/cache/
packages/contracts/broadcast/*/31337/
# Keep broadcast history for testnets (Sepolia etc.) but not local Anvil
!packages/contracts/broadcast/
!packages/contracts/broadcast/DeployMockNFT.s.sol/
packages/contracts/broadcast/DeployMockNFT.s.sol/31337/

# Foundry dependency sources — restored via `forge install`
packages/contracts/lib/

# ── Deployments ──────────────────────────────────────────────
# The local deployment JSON is machine-specific; regenerated on every deploy
packages/contracts/deployments/local.json
packages/frontend/public/deployment.json

# ── IPFS / NFT assets ────────────────────────────────────────
# Generated files — recreated by running generate.mjs
packages/contracts/nft-assets/images/
packages/contracts/nft-assets/metadata/
# Keep the generator script itself
!packages/contracts/nft-assets/generate.mjs

# ── Turbo (optional, if you add Turborepo later) ─────────────
.turbo/

# ── Misc ─────────────────────────────────────────────────────
*.log
*.pid
*.seed
*.pid.lock
.nyc_output/
coverage/
.cache/
tmp/
temp/